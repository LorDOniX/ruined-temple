//===========================================================================
// Trigger: Clear Path
//===========================================================================
function Trig_Clear_Path_Func001Func001Func001001 takes nothing returns boolean
    return ( GetOwningPlayer(GetEnumUnit()) == Player(0) )
endfunction

function Trig_Clear_Path_Func001Func001Func001003001 takes nothing returns boolean
    return ( GetOwningPlayer(GetEnumUnit()) == Player(1) )
endfunction

function Trig_Clear_Path_Func001Func001Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'n004' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'n00B' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o000' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'n00C' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Clear_Path_Func001Func001C takes nothing returns boolean
    if ( not Trig_Clear_Path_Func001Func001Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Clear_Path_Func001A takes nothing returns nothing
    if ( Trig_Clear_Path_Func001Func001C() ) then
        if ( Trig_Clear_Path_Func001Func001Func001001() ) then
            call SetUnitPositionLoc( GetEnumUnit(), GetUnitLoc(gg_unit_h000_0001) )
        else
            if ( Trig_Clear_Path_Func001Func001Func001003001() ) then
                call SetUnitPositionLoc( GetEnumUnit(), GetUnitLoc(gg_unit_h000_0005) )
            else
                call SetUnitPositionLoc( GetEnumUnit(), GetUnitLoc(gg_unit_h000_0006) )
            endif
        endif
        call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_Clear_Path_Actions takes nothing returns nothing
    call ForGroupBJ( GetUnitsInRectAll(gg_rct_Final_Path), function Trig_Clear_Path_Func001A )
    call GroupClear( GetLastCreatedGroup() )
endfunction

