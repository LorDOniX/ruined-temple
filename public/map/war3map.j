function InitGlobals takes nothing returns nothing
    local integer i = 0
    set udg_Spawn_Unit = 'n000'
    set udg_Wave_Sound = null
    set udg_Wave_Count = 1
    set udg_Spawn_Unit_Name = "Peon Invasion"
    set udg_Wave_Units = CreateGroup()
    set udg_Lives = 10
    set udg_Player_Count = 0
    set udg_Spawn_Cooldown = 0.28
    set udg_Tower_Sell_Value = 0
    set i = 0
    loop
        exitwhen (i > 3)
        set udg_Kills[i] = 0
        set i = i + 1
    endloop

    set i = 0
    loop
        exitwhen (i > 30)
        set udg_BountyBase[i] = 0
        set i = i + 1
    endloop

    set i = 0
    loop
        exitwhen (i > 30)
        set udg_Bounty_Dice[i] = 0
        set i = i + 1
    endloop

    set udg_Bounty_Given = 0
    set udg_Difficulty_Dialog = DialogCreate()
    set udg_Difficulty_Timer = CreateTimer()
    set udg_Difficulty_Factor = 100.00
    set udg_Next_Wave_Timer = CreateTimer()
endfunction

