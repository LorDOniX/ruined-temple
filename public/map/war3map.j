// -Balancing made
// -Minor graphical changes
// Updates to v.1.04:
// -Lot of tower balancing
// -Coin Basher ability for builders
// -Trading incrediment changed
//===========================================================================
function Trig_Quests_Actions takes nothing returns nothing
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_393", "TRIGSTR_394", "ReplaceableTextures\\CommandButtons\\BTNPeon.blp" )
    call CreateQuestItemBJ( GetLastCreatedQuestBJ(), "TRIGSTR_397" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_398", "TRIGSTR_399", "ReplaceableTextures\\CommandButtons\\BTNMarkOfFire.blp" )
    call CreateQuestItemBJ( GetLastCreatedQuestBJ(), "TRIGSTR_400" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_401", "TRIGSTR_402", "ReplaceableTextures\\CommandButtons\\BTNScout.blp" )
    call CreateQuestItemBJ( GetLastCreatedQuestBJ(), "TRIGSTR_403" )
endfunction

