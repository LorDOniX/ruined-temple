//===========================================================================
function Trig_Dialog_Button_Func009Func001C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dialog_Button_Func009C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dialog_Button_Actions takes nothing returns nothing
    call DialogAddButtonBJ( udg_Difficulty_Dialog, "TRIGSTR_685" )
    set udg_Difficulty_Easy = GetLastCreatedButtonBJ()
    call DialogAddButtonBJ( udg_Difficulty_Dialog, "TRIGSTR_542" )
    set udg_Difficulty_Normal = GetLastCreatedButtonBJ()
    call DialogAddButtonBJ( udg_Difficulty_Dialog, "TRIGSTR_543" )
    set udg_Difficulty_Hard = GetLastCreatedButtonBJ()
    call DialogSetMessageBJ( udg_Difficulty_Dialog, "TRIGSTR_544" )
    call StartTimerBJ( udg_Difficulty_Timer, false, 10.00 )
    if ( Trig_Dialog_Button_Func009C() ) then
        call DialogDisplayBJ( true, udg_Difficulty_Dialog, Player(0) )
        call DisplayTimedTextToForce( bj_FORCE_PLAYER[1], 10.00, "TRIGSTR_548" )
        call DisplayTimedTextToForce( bj_FORCE_PLAYER[2], 10.00, "TRIGSTR_549" )
    else
        if ( Trig_Dialog_Button_Func009Func001C() ) then
            call DialogDisplayBJ( true, udg_Difficulty_Dialog, Player(1) )
            call DisplayTimedTextToForce( bj_FORCE_PLAYER[0], 10.00, "TRIGSTR_550" )
            call DisplayTimedTextToForce( bj_FORCE_PLAYER[2], 10.00, "TRIGSTR_551" )
        else
            call DialogDisplayBJ( true, udg_Difficulty_Dialog, Player(2) )
        endif
    endif
endfunction

