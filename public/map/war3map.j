//===========================================================================
// Trigger: Sell Tower
//===========================================================================
function Trig_Sell_Tower_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A003' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sell_Tower_Actions takes nothing returns nothing
    call KillUnit( GetSpellAbilityUnit() )
    set udg_Tower_Sell_Value = ( I2R(GetUnitPointValue(GetSpellAbilityUnit())) * 0.75 )
    call AdjustPlayerStateBJ( R2I(udg_Tower_Sell_Value), GetOwningPlayer(GetSpellAbilityUnit()), PLAYER_STATE_RESOURCE_GOLD )
    call CreateTextTagUnitBJ( ( "+" + I2S(R2I(udg_Tower_Sell_Value)) ), GetSpellAbilityUnit(), 0, 10, 100, 86.00, 0.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64.00, 90 )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 4.00 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.00 )
endfunction

//===========================================================================
function InitTrig_Sell_Tower takes nothing returns nothing
    set gg_trg_Sell_Tower = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sell_Tower, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Sell_Tower, Condition( function Trig_Sell_Tower_Conditions ) )
    call TriggerAddAction( gg_trg_Sell_Tower, function Trig_Sell_Tower_Actions )
endfunction

//===========================================================================
// Trigger: Coin Basher
//
// A special move by Tower Builder (Flying).
//===========================================================================
function Trig_Coin_Basher_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A010' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Coin_Basher_Func001C takes nothing returns boolean
    if ( not ( GetPlayerState(GetOwningPlayer(GetSpellAbilityUnit()), PLAYER_STATE_RESOURCE_GOLD) >= udg_Wave_Count ) ) then
        return false
    endif
    return true
endfunction

function Trig_Coin_Basher_Actions takes nothing returns nothing
    if ( Trig_Coin_Basher_Func001C() ) then
        call AdjustPlayerStateBJ( ( udg_Wave_Count * -1 ), GetOwningPlayer(GetSpellAbilityUnit()), PLAYER_STATE_RESOURCE_GOLD )
    else
        call IssueImmediateOrderBJ( GetSpellAbilityUnit(), "stop" )
        call SetUnitAnimationWithRarity( GetSpellAbilityUnit(), "stand", RARITY_RARE )
        call PlaySoundOnUnitBJ( gg_snd_WhatNoGold, 80.00, GetSpellAbilityUnit() )
        call CreateTextTagUnitBJ( "TRIGSTR_751", GetSpellAbilityUnit(), 0, 8.00, 100, 100, 100, 0 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 3.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.50 )
    endif
endfunction

//===========================================================================
function InitTrig_Coin_Basher takes nothing returns nothing
    set gg_trg_Coin_Basher = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Coin_Basher, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Coin_Basher, Condition( function Trig_Coin_Basher_Conditions ) )
    call TriggerAddAction( gg_trg_Coin_Basher, function Trig_Coin_Basher_Actions )
endfunction

