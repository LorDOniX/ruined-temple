    call TriggerAddAction( gg_trg_Gate, function Trig_Gate_Actions )
endfunction

//===========================================================================
// Trigger: Wave Spawn
//
// 20 units per wave.
//===========================================================================
function Trig_Wave_Spawn_Actions takes nothing returns nothing
    call SetDoodadAnimationRectBJ( "birth", 'D004', gg_rct_Spawn_Region )
    call PlaySoundAtPointBJ( gg_snd_Gateway_Opens, 100, GetRectCenter(gg_rct_Spawn_Region), 0 )
    call TriggerSleepAction( 1.00 )
    call DisplayTextToForce( GetPlayersAll(), ( ( "|CFF6DCFF6Wave " + I2S(udg_Wave_Count) ) + ( ":|r " + udg_Spawn_Unit_Name ) ) )
