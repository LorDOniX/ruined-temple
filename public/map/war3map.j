        return false
    endif
    return true
endfunction

function Trig_Life_Bought_Actions takes nothing returns nothing
    call DisplayTextToForce( GetPlayersAll(), ( ( "|CFF6DCFF6" + GetPlayerName(GetOwningPlayer(GetEnteringUnit())) ) + " has bought a bonus life.|r" ) )
    call PlaySoundBJ( gg_snd_Hint )
    call KillUnit( GetEnteringUnit() )
