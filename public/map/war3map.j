//===========================================================================
// Trigger: Starting Game
//===========================================================================
function Trig_Starting_Game_Actions takes nothing returns nothing
    call TriggerExecute( gg_trg_Multiboard_Set )
    call DialogClearBJ( udg_Difficulty_Dialog )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEIN, 3.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0 )
    call TriggerSleepAction( 3.00 )
    call ClearTextMessagesBJ( GetPlayersAll() )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_559" )
    call PlaySoundBJ( gg_snd_GoodJob )
    call MultiboardMinimizeBJ( false, GetLastCreatedMultiboard() )
    call TriggerSleepAction( 8.00 )
    call ClearTextMessagesBJ( GetPlayersAll() )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_560" )
    call PlaySoundBJ( gg_snd_Hint )
    set udg_Wave_Sound = gg_snd_Wave_1
    call TriggerSleepAction( 8.00 )
    call ClearTextMessagesBJ( GetPlayersAll() )
    call TriggerExecute( gg_trg_Wave_Spawn )
endfunction

//===========================================================================
function InitTrig_Starting_Game takes nothing returns nothing
    set gg_trg_Starting_Game = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Starting_Game, function Trig_Starting_Game_Actions )
endfunction

//===========================================================================
// Trigger: Gold System
//===========================================================================
function Trig_Gold_System_Func001C takes nothing returns boolean
    if ( not ( udg_Player_Count == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gold_System_Actions takes nothing returns nothing
    if ( Trig_Gold_System_Func001C() ) then
        call SetPlayerFlagBJ( PLAYER_STATE_GIVES_BOUNTY, true, Player(3) )
    else
        call SetPlayerFlagBJ( PLAYER_STATE_GIVES_BOUNTY, false, Player(3) )
        call EnableTrigger( gg_trg_Multiplayer_Bounty )
        set udg_BountyBase[1] = 1
        set udg_Bounty_Dice[1] = 1
        set udg_BountyBase[2] = 1
        set udg_Bounty_Dice[2] = 1
        set udg_BountyBase[3] = 1
        set udg_Bounty_Dice[3] = 1
        set udg_BountyBase[4] = 1
        set udg_Bounty_Dice[4] = 2
        set udg_BountyBase[5] = 2
        set udg_Bounty_Dice[5] = 2
        set udg_BountyBase[6] = 1
        set udg_Bounty_Dice[6] = 3
        set udg_BountyBase[7] = 2
        set udg_Bounty_Dice[7] = 3
        set udg_BountyBase[8] = 3
        set udg_Bounty_Dice[8] = 3
        set udg_BountyBase[9] = 3
        set udg_Bounty_Dice[9] = 4
        set udg_BountyBase[10] = 4
        set udg_Bounty_Dice[10] = 5
        set udg_BountyBase[11] = 5
        set udg_Bounty_Dice[11] = 5
        set udg_BountyBase[12] = 5
        set udg_Bounty_Dice[12] = 6
        set udg_BountyBase[13] = 6
        set udg_Bounty_Dice[13] = 7
        set udg_BountyBase[14] = 7
        set udg_Bounty_Dice[14] = 9
        set udg_BountyBase[15] = 8
        set udg_Bounty_Dice[15] = 9
        set udg_BountyBase[16] = 10
        set udg_Bounty_Dice[16] = 10
        set udg_BountyBase[17] = 11
        set udg_Bounty_Dice[17] = 12
        set udg_BountyBase[18] = 13
        set udg_Bounty_Dice[18] = 15
        set udg_BountyBase[19] = 15
        set udg_Bounty_Dice[19] = 18
        set udg_BountyBase[20] = 20
        set udg_Bounty_Dice[20] = 20
        set udg_BountyBase[21] = 21
        set udg_Bounty_Dice[21] = 23
        set udg_BountyBase[22] = 22
        set udg_Bounty_Dice[22] = 24
        set udg_BountyBase[23] = 23
        set udg_Bounty_Dice[23] = 25
        set udg_BountyBase[24] = 24
        set udg_Bounty_Dice[24] = 26
        set udg_BountyBase[25] = 25
        set udg_Bounty_Dice[20] = 27
    endif
endfunction

