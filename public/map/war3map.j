//===========================================================================
// Trigger: Units Stay In Temple
//===========================================================================
function Trig_Units_Stay_In_Temple_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'n004' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'n00B' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'o000' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnteringUnit()) == 'n00C' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Units_Stay_In_Temple_Conditions takes nothing returns boolean
    if ( not Trig_Units_Stay_In_Temple_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Units_Stay_In_Temple_Func003001 takes nothing returns boolean
    return ( GetOwningPlayer(GetEnteringUnit()) == Player(0) )
endfunction

function Trig_Units_Stay_In_Temple_Func003003001 takes nothing returns boolean
    return ( GetOwningPlayer(GetEnteringUnit()) == Player(1) )
endfunction

function Trig_Units_Stay_In_Temple_Actions takes nothing returns nothing
    if ( Trig_Units_Stay_In_Temple_Func003001() ) then
        call SetUnitPositionLoc( GetEnteringUnit(), GetUnitLoc(gg_unit_h000_0001) )
    else
        if ( Trig_Units_Stay_In_Temple_Func003003001() ) then
            call SetUnitPositionLoc( GetEnteringUnit(), GetUnitLoc(gg_unit_h000_0005) )
        else
            call SetUnitPositionLoc( GetEnteringUnit(), GetUnitLoc(gg_unit_h000_0006) )
        endif
    endif
    call AddSpecialEffectLocBJ( GetUnitLoc(GetEnteringUnit()), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

//===========================================================================
function InitTrig_Units_Stay_In_Temple takes nothing returns nothing
    set gg_trg_Units_Stay_In_Temple = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Units_Stay_In_Temple, gg_rct_Gate )
    call TriggerAddCondition( gg_trg_Units_Stay_In_Temple, Condition( function Trig_Units_Stay_In_Temple_Conditions ) )
    call TriggerAddAction( gg_trg_Units_Stay_In_Temple, function Trig_Units_Stay_In_Temple_Actions )
endfunction

//===========================================================================
// Trigger: Player Leaves
//===========================================================================
function Trig_Player_Leaves_Func007002 takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
endfunction

function Trig_Player_Leaves_Actions takes nothing returns nothing
    set udg_Player_Count = ( udg_Player_Count - 1 )
    call SetPlayerHandicapBJ( Player(3), ( udg_Difficulty_Factor * I2R(udg_Player_Count) ) )
    call DisplayTextToForce( GetPlayersAll(), ( ( "|CFF6DCFF6" + GetPlayerName(GetTriggerPlayer()) ) + " has left the game! Difficulty has been decreased.|r" ) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, ( GetConvertedPlayerId(GetTriggerPlayer()) + 2 ), "TRIGSTR_333" )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, ( GetConvertedPlayerId(GetTriggerPlayer()) + 2 ), ( "|CFF8C8C8C" + I2S(udg_Kills[GetConvertedPlayerId(GetTriggerPlayer())]) ) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, ( GetConvertedPlayerId(GetTriggerPlayer()) + 2 ), ( "|CFF8C8C8C" + I2S(GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)) ) )
    call ForGroupBJ( GetUnitsInRectOfPlayer(GetPlayableMapRect(), GetTriggerPlayer()), function Trig_Player_Leaves_Func007002 )
    call PlaySoundBJ( gg_snd_Warning )
endfunction

