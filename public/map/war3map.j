//===========================================================================
function Trig_Gate_Repaired_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnteringUnit()) == 'h00X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gate_Repaired_Func009002 takes nothing returns nothing
    call IssueTargetDestructableOrder( GetEnumUnit(), "attack", gg_dest_ZTsg_0000 )
endfunction

function Trig_Gate_Repaired_Actions takes nothing returns nothing
    call KillUnit( GetEnteringUnit() )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_405" )
    call PlaySoundBJ( gg_snd_Gate_Repaired )
    call DisableTrigger( gg_trg_Gate_Dies )
    call KillDestructable( gg_dest_ZTsg_0000 )
    call EnableTrigger( gg_trg_Gate_Dies )
    call DestructableRestoreLife( gg_dest_ZTsg_0000, GetDestructableMaxLife(gg_dest_ZTsg_0000), true )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Gate, Player(3)), function Trig_Gate_Repaired_Func009002 )
endfunction

