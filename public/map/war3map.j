    return ( GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING )
endfunction

function Trig_Intialization_Actions takes nothing returns nothing
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 0.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0 )
    if ( Trig_Intialization_Func002001() ) then
        set udg_Player_Count = ( udg_Player_Count + 1 )
    else
        call DoNothing(  )
    endif
    if ( Trig_Intialization_Func003001() ) then
        set udg_Player_Count = ( udg_Player_Count + 1 )
    else
        call DoNothing(  )
    endif
    if ( Trig_Intialization_Func004001() ) then
        set udg_Player_Count = ( udg_Player_Count + 1 )
    else
        call DoNothing(  )
    endif
    call CreateFogModifierRectBJ( true, Player(0), FOG_OF_WAR_VISIBLE, GetPlayableMapRect() )
    call CreateFogModifierRectBJ( true, Player(1), FOG_OF_WAR_VISIBLE, GetPlayableMapRect() )
    call CreateFogModifierRectBJ( true, Player(2), FOG_OF_WAR_VISIBLE, GetPlayableMapRect() )
    call TriggerSleepAction( 0.50 )
    if ( Trig_Intialization_Func009001() ) then
        call SetPlayerStateBJ( Player(0), PLAYER_STATE_RESOURCE_GOLD, 30 )
    else
        call DoNothing(  )
    endif
    if ( Trig_Intialization_Func010001() ) then
        call SetPlayerStateBJ( Player(1), PLAYER_STATE_RESOURCE_GOLD, 30 )
    else
        call DoNothing(  )
    endif
    if ( Trig_Intialization_Func011001() ) then
        call SetPlayerStateBJ( Player(2), PLAYER_STATE_RESOURCE_GOLD, 30 )
    else
        call DoNothing(  )
    endif
    if ( Trig_Intialization_Func012001() ) then
        call PanCameraToTimedLocForPlayer( Player(0), GetUnitLoc(gg_unit_h002_0007), 0 )
    else
        call ShowUnitHide( gg_unit_h002_0007 )
    endif
    if ( Trig_Intialization_Func013001() ) then
        call PanCameraToTimedLocForPlayer( Player(1), GetUnitLoc(gg_unit_h002_0002), 0 )
    else
        call ShowUnitHide( gg_unit_h002_0002 )
    endif
    if ( Trig_Intialization_Func014001() ) then
        call PanCameraToTimedLocForPlayer( Player(2), GetUnitLoc(gg_unit_h002_0009), 0 )
    else
        call ShowUnitHide( gg_unit_h002_0009 )
    endif
    call TriggerSleepAction( 0.50 )
    call SetMapFlag( MAP_LOCK_ALLIANCE_CHANGES, true )
    call SetDestructableInvulnerableBJ( gg_dest_ZTg1_0091, true )
    call SetDestructableInvulnerableBJ( gg_dest_ZTg1_0092, true )
    call SetDoodadAnimationRectBJ( "death", 'D004', gg_rct_Spawn_Region )
    call TriggerSleepAction( 0.50 )
    set udg_Lives = ( 10 * udg_Player_Count )
    call TriggerExecute( gg_trg_Gold_System )
    call TriggerSleepAction( 0.50 )
    call TriggerExecute( gg_trg_Dialog_Button )
endfunction

//===========================================================================
function InitTrig_Intialization takes nothing returns nothing
    set gg_trg_Intialization = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Intialization, function Trig_Intialization_Actions )
endfunction

