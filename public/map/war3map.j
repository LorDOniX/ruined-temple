//===========================================================================
// Trigger: Set Difficulty
//===========================================================================
function Trig_Set_Difficulty_Func005Func001C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_Difficulty_Normal ) ) then
        return false
    endif
    return true
endfunction

function Trig_Set_Difficulty_Func005C takes nothing returns boolean
    if ( not ( GetClickedButtonBJ() == udg_Difficulty_Easy ) ) then
        return false
    endif
    return true
endfunction

function Trig_Set_Difficulty_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call DisableTrigger( gg_trg_Slow_Selector )
    call ClearTextMessagesBJ( GetPlayersAll() )
    if ( Trig_Set_Difficulty_Func005C() ) then
        set udg_Difficulty_Factor = 85.00
        call SetPlayerHandicapBJ( Player(3), ( udg_Difficulty_Factor * I2R(udg_Player_Count) ) )
        call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_553" )
    else
        if ( Trig_Set_Difficulty_Func005Func001C() ) then
            set udg_Difficulty_Factor = 100.00
            call SetPlayerHandicapBJ( Player(3), ( udg_Difficulty_Factor * I2R(udg_Player_Count) ) )
            call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_687" )
        else
            set udg_Difficulty_Factor = 120.00
            call SetPlayerHandicapBJ( Player(3), ( udg_Difficulty_Factor * I2R(udg_Player_Count) ) )
            call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_686" )
        endif
    endif
    call DialogDisplayBJ( false, udg_Difficulty_Dialog, Player(0) )
    call DialogDisplayBJ( false, udg_Difficulty_Dialog, Player(1) )
    call DialogDisplayBJ( false, udg_Difficulty_Dialog, Player(2) )
    call TriggerExecute( gg_trg_Starting_Game )
endfunction

//===========================================================================
function InitTrig_Set_Difficulty takes nothing returns nothing
    set gg_trg_Set_Difficulty = CreateTrigger(  )
    call TriggerRegisterDialogEventBJ( gg_trg_Set_Difficulty, udg_Difficulty_Dialog )
    call TriggerAddAction( gg_trg_Set_Difficulty, function Trig_Set_Difficulty_Actions )
endfunction

