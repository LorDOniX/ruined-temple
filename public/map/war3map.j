endfunction

//===========================================================================
// Trigger: Multiplayer Bounty
//===========================================================================
function Trig_Multiplayer_Bounty_Actions takes nothing returns nothing
    set udg_tempPoint[0] = GetUnitLoc(GetTriggerUnit())
    set udg_Bounty_Given = ( GetRandomInt(udg_BountyBase[udg_Wave_Count], udg_Bounty_Dice[udg_Wave_Count]) * udg_Player_Count )
    call CreateTextTagLocBJ( ( "+" + I2S(udg_Bounty_Given) ), udg_tempPoint[0], 0, 10, 100, 86.00, 0.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 2.00 )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 3.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 64, 90 )
    call AdjustPlayerStateBJ( udg_Bounty_Given, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
    call RemoveLocation(udg_tempPoint[0])
endfunction

//===========================================================================
function InitTrig_Multiplayer_Bounty takes nothing returns nothing
    set gg_trg_Multiplayer_Bounty = CreateTrigger(  )
    call DisableTrigger( gg_trg_Multiplayer_Bounty )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Multiplayer_Bounty, Player(3), EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddAction( gg_trg_Multiplayer_Bounty, function Trig_Multiplayer_Bounty_Actions )
endfunction

//===========================================================================
// Trigger: Multiboard Set
//===========================================================================
function Trig_Multiboard_Set_Func020C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Set_Func021C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Set_Func022C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Set_Actions takes nothing returns nothing
    call CreateMultiboardBJ( 3, 5, "TRIGSTR_326" )
    call MultiboardMinimizeBJ( true, GetLastCreatedMultiboard() )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 1, ( "|CFF6DCFF6Lives:|r " + I2S(udg_Lives) ) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 2, "TRIGSTR_327" )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 2, "TRIGSTR_328" )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 2, "TRIGSTR_329" )
    call MultiboardSetItemWidthBJ( GetLastCreatedMultiboard(), 1, 0, 10.00 )
    call MultiboardSetItemWidthBJ( GetLastCreatedMultiboard(), 2, 0, 4.50 )
    call MultiboardSetItemWidthBJ( GetLastCreatedMultiboard(), 3, 0, 4.50 )
    call MultiboardSetItemWidthBJ( GetLastCreatedMultiboard(), 1, 1, 6.50 )
    call MultiboardSetItemWidthBJ( GetLastCreatedMultiboard(), 2, 1, 8.00 )
    call MultiboardSetItemWidthBJ( GetLastCreatedMultiboard(), 3, 1, 4.50 )
    call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 1, 0, "ReplaceableTextures\\CommandButtons\\BTNPeasant.blp" )
    call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 2, 0, "ReplaceableTextures\\CommandButtons\\BTNDeathCoil.blp" )
    call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 3, 0, "UI\\Feedback\\Resources\\ResourceGold.blp" )
    call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 2, 1, "ReplaceableTextures\\CommandButtons\\BTNSnazzyPotion.blp" )
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, 1, true, false )
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 3, 1, true, false )
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 0, 2, true, false )
    if ( Trig_Multiboard_Set_Func020C() ) then
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 3, GetPlayerName(Player(0)) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 3, I2S(udg_Kills[1]) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 3, I2S(GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_GOLD)) )
    else
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 3, "TRIGSTR_330" )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 3, "TRIGSTR_508" )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 3, "TRIGSTR_509" )
    endif
    if ( Trig_Multiboard_Set_Func021C() ) then
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 4, GetPlayerName(Player(1)) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 4, I2S(udg_Kills[2]) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 4, I2S(GetPlayerState(Player(1), PLAYER_STATE_RESOURCE_GOLD)) )
    else
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 4, "TRIGSTR_331" )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 4, "TRIGSTR_507" )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 4, "TRIGSTR_506" )
    endif
    if ( Trig_Multiboard_Set_Func022C() ) then
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 5, GetPlayerName(Player(2)) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 5, I2S(udg_Kills[3]) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 5, I2S(GetPlayerState(Player(2), PLAYER_STATE_RESOURCE_GOLD)) )
    else
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 1, 5, "TRIGSTR_332" )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 5, "TRIGSTR_510" )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 5, "TRIGSTR_511" )
    endif
endfunction

//===========================================================================
function InitTrig_Multiboard_Set takes nothing returns nothing
    set gg_trg_Multiboard_Set = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Multiboard_Set, function Trig_Multiboard_Set_Actions )
endfunction

//===========================================================================
// Trigger: Multiboard Kills
//===========================================================================
function Trig_Multiboard_Kills_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == Player(3) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multiboard_Kills_Actions takes nothing returns nothing
    set udg_Kills[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_Kills[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 1 )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, ( GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ())) + 2 ), I2S(udg_Kills[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) )
endfunction

//===========================================================================
function InitTrig_Multiboard_Kills takes nothing returns nothing
    set gg_trg_Multiboard_Kills = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Multiboard_Kills, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Multiboard_Kills, Condition( function Trig_Multiboard_Kills_Conditions ) )
    call TriggerAddAction( gg_trg_Multiboard_Kills, function Trig_Multiboard_Kills_Actions )
endfunction

//===========================================================================
// Trigger: Multiboard Gold
//===========================================================================
function Trig_Multiboard_Gold_Actions takes nothing returns nothing
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 3, I2S(GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_GOLD)) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 4, I2S(GetPlayerState(Player(1), PLAYER_STATE_RESOURCE_GOLD)) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 3, 5, I2S(GetPlayerState(Player(2), PLAYER_STATE_RESOURCE_GOLD)) )
endfunction

