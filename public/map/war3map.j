//===========================================================================
// Trigger: Wave Clear
//===========================================================================
function Trig_Wave_Clear_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetDyingUnit()) == Player(3) ) ) then
        return false
    endif
    if ( not ( CountLivingPlayerUnitsOfTypeId(udg_Spawn_Unit, Player(3)) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wave_Clear_Func001C takes nothing returns boolean
    if ( not ( udg_Wave_Count > 24 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wave_Clear_Func004C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wave_Clear_Func005C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wave_Clear_Func006C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wave_Clear_Actions takes nothing returns nothing
    if ( Trig_Wave_Clear_Func001C() ) then
        call TriggerExecute( gg_trg_Victory )
        return
    else
        call DoNothing(  )
    endif
    if ( Trig_Wave_Clear_Func004C() ) then
        call SetPlayerStateBJ( Player(0), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(Player(0), PLAYER_STATE_RESOURCE_GOLD) + ( ( udg_Wave_Count * 10 ) + ( ( udg_Wave_Count * udg_Wave_Count ) / udg_Player_Count ) ) ) )
    else
        call DoNothing(  )
    endif
    if ( Trig_Wave_Clear_Func005C() ) then
        call SetPlayerStateBJ( Player(1), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(Player(1), PLAYER_STATE_RESOURCE_GOLD) + ( ( udg_Wave_Count * 10 ) + ( ( udg_Wave_Count * udg_Wave_Count ) / udg_Player_Count ) ) ) )
    else
        call DoNothing(  )
    endif
    if ( Trig_Wave_Clear_Func006C() ) then
        call SetPlayerStateBJ( Player(2), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(Player(2), PLAYER_STATE_RESOURCE_GOLD) + ( ( udg_Wave_Count * 10 ) + ( ( udg_Wave_Count * udg_Wave_Count ) / udg_Player_Count ) ) ) )
    else
        call DoNothing(  )
    endif
    call DisplayTextToForce( GetPlayersAll(), ( ( "All players receive |cffffcc00" + I2S(( ( udg_Wave_Count * 10 ) + ( ( udg_Wave_Count * udg_Wave_Count ) / udg_Player_Count ) )) ) + " |rextra gold for surviving the wave." ) )
    call PlaySoundBJ( gg_snd_GoodJob )
    call MultiboardSetTitleText( GetLastCreatedMultiboard(), ( "Wave " + ( I2S(udg_Wave_Count) + " completed!" ) ) )
    call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_ZTg1_0091 )
    call ModifyGateBJ( bj_GATEOPERATION_OPEN, gg_dest_ZTg1_0092 )
    call TriggerSleepAction( 3.00 )
    set udg_Wave_Count = ( udg_Wave_Count + 1 )
    call StartTimerBJ( udg_Next_Wave_Timer, false, 15.00 )
    call EnableTrigger( gg_trg_Timer_Update )
    call TriggerExecute( gg_trg_Timer_Update )
    call TriggerSleepAction( 14.90 )
    call TriggerExecute( gg_trg_Next_Wave_Set )
    call TriggerSleepAction( 0.05 )
    call ModifyGateBJ( bj_GATEOPERATION_CLOSE, gg_dest_ZTg1_0091 )
    call PlaySoundAtPointBJ( gg_snd_LockUp_Doors, 100, GetDestructableLoc(gg_dest_ZTg1_0091), 0 )
    call TriggerSleepAction( 0.05 )
    call ModifyGateBJ( bj_GATEOPERATION_CLOSE, gg_dest_ZTg1_0092 )
    call PlaySoundAtPointBJ( gg_snd_LockUp_Doors, 100, GetDestructableLoc(gg_dest_ZTg1_0092), 0 )
    call DisableTrigger( gg_trg_Timer_Update )
    call TriggerExecute( gg_trg_Clear_Path )
    call TriggerExecute( gg_trg_Wave_Spawn )
endfunction

//===========================================================================
function InitTrig_Wave_Clear takes nothing returns nothing
    set gg_trg_Wave_Clear = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Wave_Clear, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Wave_Clear, Condition( function Trig_Wave_Clear_Conditions ) )
    call TriggerAddAction( gg_trg_Wave_Clear, function Trig_Wave_Clear_Actions )
endfunction

//===========================================================================
// Trigger: Timer Update
//===========================================================================
function Trig_Timer_Update_Actions takes nothing returns nothing
    call MultiboardSetTitleText( GetLastCreatedMultiboard(), ( ( "Wave " + I2S(udg_Wave_Count) ) + ( " starting in: " + R2S(TimerGetRemaining(udg_Next_Wave_Timer)) ) ) )
endfunction

//===========================================================================
function InitTrig_Timer_Update takes nothing returns nothing
    set gg_trg_Timer_Update = CreateTrigger(  )
    call DisableTrigger( gg_trg_Timer_Update )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Timer_Update, 0.03 )
    call TriggerAddAction( gg_trg_Timer_Update, function Trig_Timer_Update_Actions )
endfunction

