    set gg_trg_Life_Lost = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Life_Lost, gg_rct_Goal )
    call TriggerAddCondition( gg_trg_Life_Lost, Condition( function Trig_Life_Lost_Conditions ) )
    call TriggerAddAction( gg_trg_Life_Lost, function Trig_Life_Lost_Actions )
endfunction

