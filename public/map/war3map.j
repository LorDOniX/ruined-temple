//===========================================================================
// Trigger: Life Lost
//===========================================================================
function Trig_Life_Lost_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(3) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Lost_Func002C takes nothing returns boolean
    if ( not ( udg_Lives > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Lost_Actions takes nothing returns nothing
    if ( Trig_Life_Lost_Func002C() ) then
        set udg_Lives = ( udg_Lives - 1 )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 1, ( "|CFF6DCFF6Lives:|r " + I2S(udg_Lives) ) )
        call DisplayTextToForce( GetPlayersAll(), ( "|CFF6DCFF6An unit has entered the gate! " + ( I2S(udg_Lives) + " lives remaining!|r" ) ) )
        call PlaySoundBJ( gg_snd_Warning )
        call SetUnitPositionLoc( GetEnteringUnit(), GetRectCenter(gg_rct_Spawn_Region) )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call KillDestructable( gg_dest_OTsp_0074 )
        call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 5.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0 )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 2, 1, ( "|CFF6DCFF6Lives:|r " + I2S(udg_Lives) ) )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_221" )
        call MultiboardSetTitleText( GetLastCreatedMultiboard(), "TRIGSTR_336" )
        call TriggerSleepAction( 4.00 )
        call CustomDefeatBJ( Player(0), "TRIGSTR_218" )
        call CustomDefeatBJ( Player(1), "TRIGSTR_219" )
        call CustomDefeatBJ( Player(2), "TRIGSTR_220" )
    endif
endfunction

