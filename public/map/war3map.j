    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_561" )
    call KillDestructable( gg_dest_OTsp_0074 )
    call CinematicFadeBJ( bj_CINEFADETYPE_FADEOUT, 5.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0, 0, 0, 0 )
    call MultiboardSetTitleText( GetLastCreatedMultiboard(), "TRIGSTR_562" )
    call TriggerSleepAction( 2.50 )
    call MultiboardSetTitleText( GetLastCreatedMultiboard(), "TRIGSTR_563" )
    call TriggerSleepAction( 1.80 )
